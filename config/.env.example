# Local demo environment — copy to repo-root `.env` (gitignored) or export in shell.
# Do not commit real tokens.

# Live MI300X OpenAI-compatible AIM endpoints (host:port or http://host:port)
MI300X_CODING_ENDPOINT=165.245.131.224:8000
MI300X_CODING_MODEL=openai/gpt-oss-120b

MI300X_GENERAL_ENDPOINT=129.212.176.75:8000
MI300X_GENERAL_MODEL=openai/gpt-oss-20b

MI300X_SPARE_ENDPOINT=129.212.177.138:8000
MI300X_SPARE_MODEL=openai/gpt-oss-20b

# Optional bearer tokens if endpoints require auth
# MI300X_CODING_TOKEN=
# MI300X_GENERAL_TOKEN=

# Hugging Face (only if pulling gated models; gpt-oss AIMs do not require it)
# HF_TOKEN=

# Adapter overrides
# TF_ADAPTERS_MOCK=0
