# Token Factory environment variables
# Copy to .env and adjust for your cluster.

# HuggingFace token (required for Semantic Router model downloads)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gateway endpoints (after port-forward or ingress)
TF_GATEWAY_URL=http://127.0.0.1:18080
TF_GATEWAY_LOCAL_PORT=18080
TF_SR_URL=http://127.0.0.1:8081
TF_SR_DASHBOARD_URL=http://localhost:8700
TF_GRAFANA_URL=http://localhost:3000
TF_PROMETHEUS_URL=http://localhost:9090
TF_UI_URL=http://localhost:8501

# Virtual model exposed to clients
TF_VIRTUAL_MODEL=token-factory/auto

# API key for gateway (demo default)
TF_API_KEY=demo-key

# Config paths (optional overrides)
TF_CONFIG_DIR=config
TF_GENERATED_DIR=generated

# Kubernetes context (optional)
KUBECONFIG=~/.kube/config
