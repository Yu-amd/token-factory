{
  "title": "Token Factory — AMD Compute Traffic",
  "uid": "token-factory-v1",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["token-factory", "semantic-router", "amd"],
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(envoy_http_downstream_rq_total[5m]))",
          "legendFormat": "downstream rps"
        }
      ]
    },
    {
      "id": 2,
      "title": "Upstream Latency p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(envoy_cluster_upstream_rq_time_bucket[5m])) by (le))",
          "legendFormat": "p95 ms"
        }
      ]
    },
    {
      "id": 3,
      "title": "Backend Split (by route rule)",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_total[5m]))",
          "legendFormat": "{{envoy_cluster_name}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Instinct / EPYC / Radeon Endpoint Health",
      "type": "stat",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [
        {
          "expr": "count(up{job=~\"envoy-gateway|semantic-router\"} == 1)",
          "legendFormat": "healthy targets"
        }
      ]
    },
    {
      "id": 5,
      "title": "Fallback / 5xx Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(envoy_http_downstream_rq_xx{envoy_response_code_class=\"5\"}[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 6,
      "title": "Model Intent Mix (SR metrics placeholder)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "description": "Wire vLLM-SR dashboard metrics or OTel spans for domain/intent breakdown",
      "targets": [
        {
          "expr": "sum(rate(envoy_cluster_upstream_rq_total[5m])) by (envoy_cluster_name)",
          "legendFormat": "{{envoy_cluster_name}}"
        }
      ]
    }
  ]
}
